@inherits LayoutComponentBase
@using Microsoft.Learn.AzureCosmosDBMongoDBVCoreQuickstart.Web.Components.Shared

<main class="min-h-screen flex flex-col bg-gray-900 text-gray-100 font-sans">
    <Header />
    @Body
</main>
<section id="blazor-error-ui" class="sticky hidden bottom-0 w-full bg-red-800 text-white p-4 shadow-lg z-50"
    data-nosnippet>
    <div class="flex items-center justify-between">
        <div class="flex-shrink-0">
            <span>
                An unhandled error has occurred.
            </span>
        </div>
        <div class="flex items-center space-x-4">
            <button class="dismiss text-white hover:text-gray-200 font-bold">🗙</button>
        </div>
    </div>
</section>