@page "/"
@using System.Collections.ObjectModel
@using Microsoft.Learn.AzureCosmosDBMongoDBVCoreQuickstart.Web.Components.Shared
@using Microsoft.Learn.AzureCosmosDBMongoDBVCoreQuickstart.Web.Components.Shared.Icons
@inject IDataService dataService
@inject IOptions<Settings> settingsOptions
@implements IDisposable
@rendermode InteractiveServer

<PageTitle>
    Product Dashboard
</PageTitle>

<section class="flex-grow p-6 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    <div class="bg-gray-800 p-4 rounded-lg shadow-md col-span-3 lg:col-span-1">
        <h2 class="text-xl font-semibold text-white font-light">
            Operations
        </h2>
        <p class="mt-2 text-gray-400 text-italic text-xs italic">
            Add products
        </p>
        <div class="mt-4 @(Connected ? string.Empty : "hidden")">
            <form class="border bg-gray-900 border-gray-900 border-2 rounded-xl"
                @onsubmit="async (e) => { await AddItemAsync(); }">
                <div class="flex justify-between items-center text-gray-400 bg-gray-900 rounded-t-xl px-4 py-2">
                    <div>
                        <span class="font-semibold">
                            New product form
                        </span>
                    </div>
                    <div class="flex space-x-2">
                        <button type="button" class="text-right" @onclick="(e) => { ResetProductForm(); }">
                            <svg xmlns="http://www.w3.org/2000/svg"
                                class="inline-block size-6 stroke-gray-700 fill-gray-500 hover:stroke-gray-100 hover:fill-gray-500"
                                fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round"
                                    d="m11.25 9-3 3m0 0 3 3m-3-3h7.5M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                            </svg>
                        </button>
                        <button type="submit" class="text-right">
                            <svg xmlns="http://www.w3.org/2000/svg"
                                class="inline-block size-6 stroke-gray-700 fill-gray-500 hover:stroke-gray-100 hover:fill-gray-500"
                                fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round"
                                    d="M12 9v6m3-3H9m12 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                            </svg>
                        </button>
                    </div>
                </div>
                <div class="bg-gray-700 text-gray-200 rounded-b-xl p-4">
                    <div class="space-y-4">
                        <div>
                            <label for="Name" class="block text-sm font-medium">Name</label>
                            <input type="text" id="Name" @bind="Product.Name" placeholder="e.g. Example product"
                                class="mt-1 px-2 py-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm"
                                required />
                        </div>
                        <div>
                            <label for="Category" class="block text-sm font-medium">Category</label>
                            <input type="text" id="Category" @bind="Product.Category"
                                placeholder="e.g. gear-hiking-poles"
                                class="mt-1 px-2 py-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm"
                                required />
                        </div>
                        <div>
                            <label for="Price" class="block text-sm font-medium">Price</label>
                            <input type="number" id="Price" @bind="Product.Price" step="0.01"
                                class="mt-1 px-2 py-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm"
                                required />
                        </div>
                        <div>
                            <label for="Quantity" class="block text-sm font-medium">Quantity</label>
                            <input type="number" id="Quantity" @bind="Product.Quantity"
                                class="mt-1 px-2 py-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm"
                                required />
                        </div>
                        <div class="flex items-center">
                            <input type="checkbox" id="Clearance" @bind="Product.Clearance"
                                class="h-4 w-4 text-indigo-600 border-gray-300 rounded focus:ring-indigo-500" />
                            <label for="Clearance" class="ml-2 block text-sm font-medium">Clearance</label>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
    <div class="bg-gray-800 p-4 rounded-lg shadow-md col-span-3 lg:col-span-2">
        <div class="flex justify-between items-center">
            <h2 class="text-xl font-semibold text-white font-light">
                Inventory
            </h2>
            <div class="flex items-center space-x-0">
                <button
                    class="bg-gray-600 hover:bg-gray-500 border-gray-800 border cursor-pointer disabled:cursor-not-allowed lg:ps-8 lg:pe-8 ps-4 pe-4 disabled:pe-8 py-1 rounded-s-xl text-gray-300 hover:text-gray-100 disabled:text-gray-500 disabled:hover:bg-gray-600 font-bold @(Products.Any() ? "rounded-e-none" : "rounded-e-xl")"
                    @onclick="async (_) => await RetrieveProductsAsync()" disabled="@(Loading || !Connected)">
                    <span>
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5"
                            stroke="currentColor" class="size-6">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182m0-4.991v4.99" />
                        </svg>
                    </span>
                </button>
                @if (Products.Any())
                {
                    <div class="rounded-e-xl bg-gray-600 border-gray-800 border border-l-1 ps-2 pe-2 lg:ps-4 lg:pe-4 py-1">
                        <span class="text-gray-400 italic font-semibold font-mono">
                            @($"{Products.Count:000}")
                        </span>
                    </div>
                }
            </div>
        </div>
        <p class="mt-2 text-gray-400 text-italic text-xs italic">
            Full list of products
        </p>
        <div class="mt-4 lg:overflow-y-auto lg:max-h-[calc(100vh-16rem)]">
            @if (Loading)
            {
                <div class="bg-gray-700 p-2 rounded-lg mb-2 animate-pulse border border-gray-900 p-4">
                    <div class="flex space-x-4">
                        <div class="flex-1 space-y-6 py-1">
                            <div class="rounded h-2 bg-gray-400">
                            </div>
                            <div class="space-y-2">
                                <div class="grid grid-cols-3 gap-4">
                                    <div class="col-span-2 h-2 rounded bg-gray-400">
                                    </div>
                                    <div class="col-span-1 h-2 rounded bg-gray-400">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
            else
            {
                @foreach (var product in Products)
                {
                    <div class="text-gray-200 bg-gray-700 rounded-lg mb-2 border border-gray-900 p-4">
                        <div class="flex space-x-4">
                            <div class="flex-1 space-y-2 lg:space-y-4">
                                <div class="text-lg font-semibold px-2 rounded grid grid-cols-6 lg:grid-cols-12">
                                    <div class="col-span-5 lg:col-span-10">
                                        @product.Name
                                        @if (product.Clearance)
                                        {
                                            <svg xmlns="http://www.w3.org/2000/svg" class="ml-2 size-3 inline-block text-green-300"
                                                fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round"
                                                    d="M9.568 3H5.25A2.25 2.25 0 0 0 3 5.25v4.318c0 .597.237 1.17.659 1.591l9.581 9.581c.699.699 1.78.872 2.607.33a18.095 18.095 0 0 0 5.223-5.223c.542-.827.369-1.908-.33-2.607L11.16 3.66A2.25 2.25 0 0 0 9.568 3Z" />
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M6 6h.008v.008H6V6Z" />
                                            </svg>
                                        }
                                    </div>
                                    <div class="col-span-1 lg:col-span-2 text-right">
                                        <button class="cursor-pointer"
                                            @onclick="async (_) => await DeleteProductAsync(product)">
                                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                                                stroke-width="1.5" stroke="currentColor"
                                                class="size-6 stroke-gray-700 fill-gray-500 hover:stroke-gray-100 hover:fill-gray-500">
                                                <path stroke-linecap="round" stroke-linejoin="round"
                                                    d="m9.75 9.75 4.5 4.5m0-4.5-4.5 4.5M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                                            </svg>
                                        </button>
                                    </div>
                                </div>
                                <div class="grid grid-cols-6 gap-2">
                                    <div class="px-2 col-span-6 lg:col-span-4 text-md italic rounded font-mono">
                                        @product.Category
                                    </div>
                                    <div class="px-2 col-span-3 lg:col-span-1 text-sm rounded">
                                        Price:
                                        <span
                                            class="italic font-semibold font-mono @(product.Clearance ? "text-green-300" : string.Empty)">
                                            @($"{product.Price:C}")
                                        </span>
                                    </div>
                                    <div class="px-2 col-span-3 lg:col-span-1 text-sm rounded">
                                        Quantity:
                                        <span
                                            class="italic font-semibold font-mono @(product.Quantity <= 10 ? "text-red-300" : string.Empty)">
                                            @($"{product.Quantity:G}")
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</section>
<footer class="bg-gray-800 text-gray-200 px-4 py-1 text-center font-mono">
    <span class="italic text-xs md:text-sm">
        @if (Endpoint is not null)
        {
            <span class="text-green-400">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" class="inline-block mr-2 size-4" viewBox="0 0 24 24"
                    stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round"
                        d="M12 18v-5.25m0 0a6.01 6.01 0 0 0 1.5-.189m-1.5.189a6.01 6.01 0 0 1-1.5-.189m3.75 7.478a12.06 12.06 0 0 1-4.5 0m3.75 2.383a14.406 14.406 0 0 1-3 0M14.25 18v-.192c0-.983.658-1.823 1.508-2.316a7.5 7.5 0 1 0-7.517 0c.85.493 1.509 1.333 1.509 2.316V18" />
                </svg>
                <span class="hidden md:inline">
                    Connected
                </span>
                <span class="@(settingsOptions.Value?.ShowEndpoint == true ? string.Empty : "hidden")">
                    <span>
                        to
                    </span>
                    <strong>
                        @Endpoint
                    </strong>
                </span>
            </span>
        }
        else if (ErrorMessage is not null)
        {
            <span class="text-red-400">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" class="inline-block mr-2 size-4" viewBox="0 0 24 24"
                    stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round"
                        d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z" />
                </svg>
                <strong>
                    @ErrorMessage
                </strong>
            </span>
        }
        else
        {
            <span class="text-slate-400">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" class="inline-block mr-2 size-4" viewBox="0 0 24 24"
                    stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round"
                        d="M12 9v3.75m9-.75a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 3.75h.008v.008H12v-.008Z" />
                </svg>
                <span>
                    Not connected
                </span>
            </span>
        }
    </span>
</footer>

@code {
    private CancellationTokenSource cancellationTokenSource = new();

    private string? Endpoint { get; set; } = default;

    private string? ErrorMessage { get; set; } = default;

    [SupplyParameterFromForm]
    private Product Product { get; set; } = Product.GenerateDefaultProduct();

    private bool Loading { get; set; } = true;

    private bool Connected { get; set; } = false;

    private Random random = new();

    private ObservableCollection<Product> Products { get; set; } = [];

    protected override async Task OnInitializedAsync()
    {
        await ConnectAsync();
        if (Connected)
        {
            await RetrieveProductsAsync();
        }
    }

    private async Task ConnectAsync()
    {
        Loading = true;
        StateHasChanged();

        (bool success, string endpoint) = await dataService.ConnectAsync(cancellationTokenSource.Token);

        Connected = success;

        if (!Connected)
        {
            ErrorMessage = "Failed to connect to the server.";
        }
        else
        {
            Endpoint = endpoint;
            ErrorMessage = null;
        }

        cancellationTokenSource.Token.ThrowIfCancellationRequested();

        Loading = false;
        StateHasChanged();
    }

    private async Task RetrieveProductsAsync()
    {
        Loading = true;
        Products.Clear();
        StateHasChanged();

        IAsyncEnumerable<Product> products = dataService.GetProductsAsync(cancellationTokenSource.Token);
        List<Product> output = [];
        await foreach (Product product in products)
        {
            Products.Add(product);
        }

        cancellationTokenSource.Token.ThrowIfCancellationRequested();

        Loading = false;
        StateHasChanged();
    }

    private async Task DeleteProductAsync(Product product)
    {
        Loading = true;
        StateHasChanged();

        bool success = await dataService.DeleteProductAsync(product.Id, cancellationTokenSource.Token);

        if (success)
        {
            await RetrieveProductsAsync();
        }

        Loading = false;
        StateHasChanged();
    }

    private async Task AddItemAsync()
    {
        Loading = true;
        StateHasChanged();

        Product product = Product with { };

        ResetProductForm();

        bool success = await dataService.UpsertProductAsync(product, cancellationTokenSource.Token);

        if (success)
        {
            await RetrieveProductsAsync();
        }

        Loading = false;
        StateHasChanged();
    }

    private void ResetProductForm()
    {
        Product = Product.GenerateDefaultProduct();

        StateHasChanged();
    }

    public void Dispose()
    {
        if (!cancellationTokenSource.IsCancellationRequested)
        {
            cancellationTokenSource.Cancel();
        }

        cancellationTokenSource.Dispose();
        dataService.Dispose();
    }
}